<Window x:Class="WidgetTools.SystemMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Monitor"
        Width="248" Height="164"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <Canvas x:Name="Root">

        <!-- ============ Expanded card ============ -->
        <Border x:Name="Card" Width="248" Height="164" CornerRadius="14"
                Background="#E6121212" Opacity="0" IsHitTestVisible="False"
                ClipToBounds="True" RenderTransformOrigin="1,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.3" ScaleY="0.3" />
            </Border.RenderTransform>
            <Grid Margin="14,10,14,12">
                <TextBlock Text="System" Foreground="White" FontFamily="Segoe UI"
                           FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
                <TextBlock x:Name="CloseBtn" Text="&#x2715;" Foreground="#B3B3B3"
                           FontFamily="Segoe UI" FontSize="11" Cursor="Hand"
                           HorizontalAlignment="Right" VerticalAlignment="Top" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,16,0,0">
                    <!-- CPU ring -->
                    <Grid Width="96" Height="96" Margin="6,0">
                        <Ellipse Width="68" Height="68" Stroke="#3A3A3A" StrokeThickness="9" />
                        <Path x:Name="CpuArc" Stroke="#1DB954" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="#B3B3B3" FontFamily="Segoe UI"
                                       FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock x:Name="CpuText" Text="0%" Foreground="White"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <!-- RAM ring -->
                    <Grid Width="96" Height="96" Margin="6,0">
                        <Ellipse Width="68" Height="68" Stroke="#3A3A3A" StrokeThickness="9" />
                        <Path x:Name="RamArc" Stroke="#1DB954" StrokeThickness="9"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="RAM" Foreground="#B3B3B3" FontFamily="Segoe UI"
                                       FontSize="10" HorizontalAlignment="Center" />
                            <TextBlock x:Name="RamText" Text="0%" Foreground="White"
                                       FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="17"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Collapsed badge (CPU at a glance) ============ -->
        <Grid x:Name="Badge" Width="72" Height="72" Canvas.Left="176" Canvas.Top="0" Cursor="Hand">
            <Ellipse Width="72" Height="72" Fill="#E6121212" />
            <Ellipse Width="52" Height="52" Stroke="#3A3A3A" StrokeThickness="7" />
            <Path x:Name="BadgeArc" Stroke="#1DB954" StrokeThickness="7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="CPU" Foreground="#B3B3B3" FontFamily="Segoe UI"
                           FontSize="8" HorizontalAlignment="Center" />
                <TextBlock x:Name="BadgeText" Text="0%" Foreground="White" FontFamily="Segoe UI"
                           FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Canvas>
</Window>
