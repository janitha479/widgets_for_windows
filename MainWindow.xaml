<Window x:Class="WidgetTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Overlay"
        Width="320" Height="142"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <!-- Background is Transparent only on the window; the Canvas itself has no
         fill, so empty areas are truly see-through (no color-key hack needed). -->
    <Canvas x:Name="Root">

        <!-- ============ Expanded card ============ -->
        <Border x:Name="Card" Width="320" Height="142" CornerRadius="14"
                Opacity="0" IsHitTestVisible="False" ClipToBounds="True"
                RenderTransformOrigin="1,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="0.25" ScaleY="0.25" />
            </Border.RenderTransform>
            <Grid>
                <!-- blurred, darkened album art as the card background -->
                <Image x:Name="BgImage" Stretch="UniformToFill">
                    <Image.Effect><BlurEffect Radius="26" /></Image.Effect>
                </Image>
                <Rectangle Fill="#AA000000" />

                <!-- sharp thumbnail -->
                <Border Width="76" Height="76" Margin="12,16,0,0" CornerRadius="10"
                        HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                    <Image x:Name="Thumb" Stretch="UniformToFill" />
                </Border>

                <TextBlock x:Name="TitleText" Foreground="White" FontFamily="Segoe UI"
                           FontWeight="Bold" FontSize="13" Margin="100,24,30,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ArtistText" Foreground="#B3B3B3" FontFamily="Segoe UI"
                           FontSize="10" Margin="100,46,30,0" TextTrimming="CharacterEllipsis" />

                <!-- transport controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Margin="0,82,0,0">
                    <TextBlock x:Name="PrevBtn" Text="&#x23EE;&#xFE0E;" Foreground="White"
                               FontSize="18" Margin="12,0" Cursor="Hand" />
                    <TextBlock x:Name="PlayBtn" Text="&#x23F5;&#xFE0E;" Foreground="White"
                               FontSize="22" Margin="12,0" Cursor="Hand" />
                    <TextBlock x:Name="NextBtn" Text="&#x23ED;&#xFE0E;" Foreground="White"
                               FontSize="18" Margin="12,0" Cursor="Hand" />
                </StackPanel>

                <TextBlock x:Name="CloseBtn" Text="&#x2715;" Foreground="#B3B3B3"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,8,12,0" Cursor="Hand" />

                <!-- progress bar -->
                <Grid Height="4" VerticalAlignment="Top" Margin="14,118,14,0">
                    <Rectangle Fill="#5A5A5A" RadiusX="2" RadiusY="2" />
                    <Rectangle x:Name="BarFill" Fill="White" RadiusX="2" RadiusY="2"
                               HorizontalAlignment="Left" Width="0" />
                    <!-- transparent hit area for seeking -->
                    <Rectangle x:Name="BarHit" Fill="#01000000" Margin="0,-6" Cursor="Hand" />
                </Grid>
                <TextBlock x:Name="TimeCur" Foreground="#B3B3B3" FontSize="8"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,126,0,0" />
                <TextBlock x:Name="TimeTot" Foreground="#B3B3B3" FontSize="8"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,126,14,0" />
            </Grid>
        </Border>

        <!-- ============ Collapsed disk + reactive ring (top-right) ============ -->
        <Grid x:Name="DiskGroup" Width="104" Height="104" Canvas.Left="216" Canvas.Top="0">
            <Canvas x:Name="RingCanvas" Width="104" Height="104" />
            <Ellipse x:Name="Disk" Width="64" Height="64" Cursor="Hand"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Stroke="#CC000000" StrokeThickness="2">
                <Ellipse.Fill>
                    <ImageBrush x:Name="DiskBrush" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>
            <!-- vinyl hole -->
            <Ellipse Width="14" Height="14" Fill="#121212"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Ellipse Width="4" Height="4" Fill="#969696"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
    </Canvas>
</Window>
